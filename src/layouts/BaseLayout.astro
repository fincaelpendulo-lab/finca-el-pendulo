---
// Every page uses this layout: SEO tags, hreflang, Open Graph, JSON-LD, a strict
// CSP built from site.json, consent-first GA4, cookie banner and the site script.
// Header, footer and the mobile booking bar come from the design system components.
import '../styles/tokens.css';
import '../styles/global.css';
import CookieBanner from '../components/CookieBanner.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import site from '../data/site.json';
import { absolute } from '../lib/url';
import { counterparts, type Lang } from '../lib/i18n';

interface Crumb { name: string; path: string; }
interface Props {
  title: string;
  description: string;
  path: string;
  lang?: Lang;
  /** The same page in the other language when it is not in the route list. */
  alternate?: string | null;
  ogType?: 'website' | 'article';
  ogImage?: string;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** "overlay" when the page starts with a Hero/PageHeader photo: the header sits on it. */
  header?: 'overlay' | 'solid';
}

const { title, description, path, lang = 'es', alternate, ogType = 'website', ogImage = 'home', breadcrumbs, schema = [], noindex = false, header = 'overlay' } = Astro.props;
// A language version is only linked once its page is actually built.
const built = new Set(Object.keys(import.meta.glob('/src/pages/**/*.astro')).map((f) =>
  f.replace(/^\/src\/pages/, '').replace(/\.astro$/, '').replace(/\/index$/, '') || '/'));
const pair = counterparts(path, lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
let switchTo = alternate !== undefined ? alternate : pair[other];
if (switchTo && alternate === undefined && !built.has(switchTo)) switchTo = null;
const versions = { [lang]: path, ...(switchTo ? { [other]: switchTo } : {}) } as Record<Lang, string>;
const canonical = absolute(path);
const ogUrl = `${site.url}/og/${ogImage}.jpg`;
// The GitHub Pages copy (served under a project path) stays hidden so it never competes with the domain.
const hideFromSearch = noindex || !site.launched || import.meta.env.BASE_URL.replace(/\/$/, '') !== '';

const organization = {
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: `${site.url}/`,
  logo: `${site.url}/icons/icon-512.png`,
  ...(site.email ? { email: site.email } : {}),
  ...(site.whatsapp.display ? { telephone: site.whatsapp.display.replace(/\s/g, '') } : {}),
  sameAs: [site.instagram, site.facebook, site.youtube.channel].filter(Boolean),
};
// Tells Google the site's name for search results.
const website = { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: `${site.url}/`, publisher: { '@id': `${site.url}/#organization` } };
const graph: Record<string, unknown>[] = [organization, ...(path === '/' || path === '/en' ? [website] : []), ...schema];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: site.name, path: lang === 'en' ? '/en' : '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: absolute(c.path),
    })),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// CSP: add an origin here whenever a new third party is embedded, or it will be blocked.
const connect = ["'self'", 'https://challenges.cloudflare.com', 'https://*.google-analytics.com', 'https://*.analytics.google.com', 'https://*.googletagmanager.com'];
// Google Ads conversion tag (site.adsId): counts form submissions that reach /gracias.
const ads = site.adsId ? ['https://www.googleadservices.com', 'https://googleads.g.doubleclick.net', 'https://www.google.com'] : [];
if (site.adsId) connect.push(...ads, 'https://*.doubleclick.net', 'https://pagead2.googlesyndication.com');
const formOrigin = site.formEndpoint ? new URL(site.formEndpoint).origin : '';
if (formOrigin) connect.push(formOrigin);
const bookingOrigin = [site.booking.embed, site.callBooking?.embed].filter(Boolean).map((u) => new URL(u).origin).join(' ');
const csp = [
  "default-src 'self'",
  `script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com ${ads.join(' ')} ${bookingOrigin}`.replace(/\s+/g, ' ').trim(),
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data: https://i.ytimg.com https://*.google-analytics.com https://www.googletagmanager.com${site.adsId ? ' https://googleads.g.doubleclick.net https://www.google.com https://www.google.com.mx https://*.googleadservices.com' : ''}`,
  "font-src 'self'",
  `connect-src ${connect.join(' ')}`,
  `frame-src https://www.google.com https://www.youtube-nocookie.com https://challenges.cloudflare.com${site.adsId ? ' https://td.doubleclick.net https://www.googletagmanager.com' : ''} ${bookingOrigin}`.trim(),
  "media-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  `form-action 'self'${formOrigin ? ` ${formOrigin}` : ''}`,
  'upgrade-insecure-requests',
].join('; ');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Changes on every build, so browsers fetch the new scripts after each publish.
const v = Date.now().toString(36);
---
<!doctype html>
<html lang={lang} class="no-js">
<head>
  <meta charset="utf-8" />
  <script is:inline src={`${base}/js/boot.js?v=${v}`} data-ga={site.ga4Id || undefined} data-ads={site.adsId || undefined}></script>
  {(site.ga4Id || site.adsId) && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id || site.adsId}`}></script>}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
  {switchTo && Object.entries(versions).map(([l, p]) => <link rel="alternate" hreflang={l} href={absolute(p)} />)}
  {switchTo && <link rel="alternate" hreflang="x-default" href={absolute(versions.es ?? path)} />}

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href={`${base}/favicon.ico`} sizes="32x32" />
  <link rel="icon" href={`${base}/icons/icon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/icons/icon-192.png`} sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/icons/apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
  <meta name="theme-color" content="#8b2d1e" />

  <script type="application/ld+json" set:html={jsonLd} />
</head>
<body data-ga={site.ga4Id || undefined} data-base={base}>
  <a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
  <SiteHeader lang={lang} path={path} switchTo={switchTo} variant={header} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <SiteFooter lang={lang} />
  <WhatsAppFloat lang={lang} />
  <NewsletterPopup lang={lang} />
  <CookieBanner lang={lang} />
  <script is:inline src={`${base}/js/site.js?v=${v}`} defer></script>
</body>
</html>

<style is:global>
  main:focus { outline: none; }
  .no-js [data-cookie-settings] { display: none; }
</style>
