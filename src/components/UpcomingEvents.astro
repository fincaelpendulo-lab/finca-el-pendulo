---
// Próximos eventos: retreats, events and activities at the Finca, from src/data/proximos.json.
// Each entry: { "date": "2027-03-14", "endDate"?: "2027-03-16", "title": {es,en}, "kind": {es,en}, "text"?: {es,en}, "link"?: "https://..." }
// Past dates hide themselves at build time. With no entries the section shows an invitation to write.
import proximos from '../data/proximos.json';
import { whatsappUrl } from '../lib/url';
import type { Lang } from '../lib/i18n';
interface Item { date: string; endDate?: string; title: { es: string; en: string }; kind: { es: string; en: string }; text?: { es: string; en: string }; link?: string }
interface Props { lang: Lang; deep?: boolean }
const { lang, deep } = Astro.props;
const es = lang === 'es';
const today = new Date().toISOString().slice(0, 10);
const items = (proximos as Item[]).filter((x) => (x.endDate ?? x.date) >= today).sort((a, b) => a.date.localeCompare(b.date));
const fmt = (d: string) => new Date(`${d}T12:00:00`).toLocaleDateString(es ? 'es-MX' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric' });
---
<section class:list={['section', deep && 'deep']} id="proximos">
  <div class="wrap">
    <p class="label">{es ? 'Agenda' : 'Calendar'}</p>
    <div class="split-head">
      <h2 class="t-heading">{es ? 'Próximos eventos' : 'Upcoming events'}</h2>
      <p class="muted" style="max-width: 40ch">{es ? 'Retiros, eventos y actividades abiertas en la Finca.' : 'Retreats, events and open activities at the Finca.'}</p>
    </div>
    {items.length ? (
      <ul class="rule-list upcoming">
        {items.map((x) => {
          const Tag = x.link ? 'a' : 'div';
          return (
            <li><Tag class="upcoming__row" href={x.link}>
              <span class="upcoming__date">{fmt(x.date)}{x.endDate && ` – ${fmt(x.endDate)}`}</span>
              <span><span class="label label--tight">{x.kind[lang]}</span><span class="t-title upcoming__title">{x.title[lang]}</span>{x.text && <span class="muted">{x.text[lang]}</span>}</span>
            </Tag></li>
          );
        })}
      </ul>
    ) : (
      <div class="card upcoming__empty">
        <p class="t-title">{es ? 'Pronto anunciaremos nuevas fechas.' : 'New dates are coming soon.'}</p>
        <p class="muted">{es ? 'Escríbenos por WhatsApp y te avisamos de los próximos retiros, eventos y actividades.' : 'Message us on WhatsApp and we will let you know about upcoming retreats, events and activities.'}</p>
        <div><a class="fp-btn fp-btn--secondary" href={whatsappUrl} data-track="whatsapp">{es ? 'Avísame por WhatsApp' : 'Tell me on WhatsApp'}</a></div>
      </div>
    )}
  </div>
</section>
<style>
  .upcoming__row { display: grid; grid-template-columns: 240px 1fr; gap: 24px; color: inherit; text-decoration: none; }
  .upcoming__row > span:last-child { display: flex; flex-direction: column; gap: 6px; }
  a.upcoming__row:hover .upcoming__title { text-decoration: underline; text-underline-offset: 6px; }
  .upcoming__date { font-family: var(--font-display); font-size: 22px; }
  .upcoming__empty { max-width: 720px; }
  @media (max-width: 760px) { .upcoming__row { grid-template-columns: 1fr; gap: 8px; } }
</style>
