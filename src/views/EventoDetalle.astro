---
// One page per kind of event (campamentos, conciertos, cenas románticas, festivales), built from eventos.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import UpcomingEvents from '../components/UpcomingEvents.astro';
import SpaceCard from '../components/SpaceCard.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import eventos from '../data/eventos.json';
import { href, whatsappUrl } from '../lib/url';
import { localize, type Lang } from '../lib/i18n';
interface Props { lang: Lang; id: string }
const { lang, id } = Astro.props;
const es = lang === 'es';
const L = (p: string) => href(localize(p, lang));
const e = eventos.find((x) => x.id === id)!;
const path = localize(e.link, lang);
const others = eventos.filter((x) => x.id !== id);
const name = e.name[lang];
---
<BaseLayout lang={lang} path={path}
  title={es ? `${name} en Tepatitlán, Jalisco | Finca El Péndulo` : `${name} near Guadalajara, Jalisco | Finca El Péndulo`}
  description={(e.description ?? e.intro!)[lang]}
  ogImage="events" breadcrumbs={[{ name: es ? 'Eventos' : 'Events', path: localize('/eventos', lang) }, { name, path }]}>
  <PageHeader lang={lang} image={e.photo} alt={e.alt[lang]} eyebrow={es ? 'Eventos' : 'Events'} title={name}>{e.text[lang]}</PageHeader>
  <section class="section">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="label">{es ? 'En la Finca' : 'At the Finca'}</p>
        <p class="t-lead">{e.intro![lang]}</p>
        <div class="cluster">
          <Button href="#cotiza-evento">{es ? 'Pide informes' : 'Ask for details'}</Button>
          <Button href={whatsappUrl} variant="secondary" track="whatsapp">WhatsApp</Button>
        </div>
      </div>
      <div class="stack">
        <h2 class="t-title">{es ? 'Qué ofrecemos' : 'What we offer'}</h2>
        <ul class="rule-list">{e.points![lang].map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>
  <div class="photo-row" style="--min: 260px; --h: 420px; padding: 0 12px">
    {e.gallery!.map((g) => <Photo name={g} alt={name} sizes="(max-width: 760px) 100vw, 33vw" widths={[480, 800, 1200]} />)}
  </div>
  <UpcomingEvents lang={lang} />
  <section class="section section--arena" id="cotiza-evento">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="label">{es ? 'Informes' : 'Enquiries'}</p>
        <h2 class="t-heading">{es ? `Cuéntanos de tu evento` : `Tell us about your event`}</h2>
        <p class="muted">{es ? 'Dinos la fecha, cuántas personas esperas y qué tienes en mente. Te respondemos con opciones de espacios, hospedaje y alimentos.' : 'Tell us the date, how many guests you expect and what you have in mind. We will reply with options for spaces, lodging and food.'}</p>
      </div>
      <div class="form-card"><ContactForm lang={lang} interest="evento" id="evento-form" crm="evento" /></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <p class="label">{es ? 'Otros eventos' : 'Other events'}</p>
      <h2 class="t-heading" style="margin: 24px 0 48px">{es ? 'También celebramos' : 'We also host'}</h2>
      <div class="cards cards--3">
        {others.slice(0, 3).map((o) => <SpaceCard href={L(o.link)} image={o.photo} alt={o.alt[lang]} title={o.name[lang]} description={o.text[lang]} ratio="4 / 3" />)}
      </div>
    </div>
  </section>
</BaseLayout>
