---
// Casos de éxito: organizers who hold their retreats at the Finca, with links to their sites.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Reviews from '../components/Reviews.astro';
import { Image } from 'astro:assets';
import mexisolLogo from '../assets/brand/mexisol-world.png';
import vatLogo from '../assets/brand/viviendo-a-tope.png';
import franciskaLogo from '../assets/brand/franciska-decodifica.png';
import { t } from '../data/ui';
import { href } from '../lib/url';
import { localize, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const L = (p: string) => href(localize(p, lang));
const path = localize('/casos-de-exito', lang);
const mexisol = es ? 'https://mexisol.world/es' : 'https://mexisol.world/';
const mexisolFinca = es ? 'https://mexisol.world/es/finca-el-pendulo' : 'https://mexisol.world/finca-el-pendulo';
---
<BaseLayout lang={lang} path={path}
  title={es ? 'Casos de éxito: retiros en Finca El Péndulo | Jalisco' : 'Success stories: retreats at Finca El Péndulo | Jalisco'}
  description={es ? 'Organizadores que realizan sus retiros en Finca El Péndulo, centro holístico cerca de Guadalajara. MexiSol World, Viviendo a Tope, Franciska Decodifica y cómo trabajan con la Finca.' : 'Organizers who hold their retreats at Finca El Péndulo, a holistic centre near Guadalajara. MexiSol World, Viviendo a Tope, Franciska Decodifica and how they work with the Finca.'}
  breadcrumbs={[{ name: es ? 'Casos de éxito' : 'Success stories', path }]}>
  <PageHeader lang={lang} image="esp-osho-hut-1" alt={es ? 'Interior del Osho Hut preparado para un retiro' : 'Inside the Osho Hut, set up for a retreat'} eyebrow={es ? 'Quiénes somos' : 'About us'} title={es ? 'Casos de éxito' : 'Success stories'}>
    {es ? 'Facilitadores y organizaciones que eligieron la Finca como casa para sus retiros.' : 'Facilitators and organizations that chose the Finca as the home for their retreats.'}
  </PageHeader>

  <section class="section">
    <div class="wrap grid-2" style="align-items: center">
      <div class="stack">
        <Image src={mexisolLogo} alt="MexiSol World" class="case-logo" width={240} />
        <p class="label">01 / MexiSol World</p>
        <h2 class="t-heading">{es ? 'Retiros de bienestar con grupos internacionales' : 'Wellbeing retreats with international groups'}</h2>
        <p>{es ? 'MexiSol World organiza retiros de bienestar y sanación para grupos pequeños que llegan de distintos países. Eligió Finca El Péndulo como su casa en Los Altos de Jalisco: aquí sus participantes se hospedan, comen y viven cada ceremonia y actividad en los espacios de la Finca.' : 'MexiSol World runs wellbeing and healing retreats for small groups who come from many countries. It chose Finca El Péndulo as its home in the highlands of Jalisco: its guests stay, eat and take part in every ceremony and activity in the Finca’s spaces.'}</p>
        <ul class="rule-list rule-list--soft">
          <li>{es ? 'Hospedaje, alimentos y espacios para todo el grupo' : 'Lodging, meals and spaces for the whole group'}</li>
          <li>{es ? 'Ceremonias en el Osho Hut y el Oráculo' : 'Ceremonies in the Osho Hut and the Oráculo'}</li>
          <li>{es ? 'Temazcal, caballos, Lago Ávalon y talleres entre sesiones' : 'Temazcal, horses, Lake Ávalon and workshops between sessions'}</li>
        </ul>
        <div class="cluster">
          <a class="fp-btn fp-btn--primary" href={mexisol} rel="noopener" target="_blank">{es ? 'Visita MexiSol World' : 'Visit MexiSol World'}</a>
          <a class="fp-btn fp-btn--secondary" href={mexisolFinca} rel="noopener" target="_blank">{es ? 'Sus retiros en la Finca' : 'Their retreats at the Finca'}</a>
        </div>
      </div>
      <div class="pair">
        <Photo name="esp-oraculo-1" alt={es ? 'El Oráculo iluminado de noche' : 'The Oráculo lit at night'} class="ratio-3-4" sizes="(max-width: 900px) 50vw, 25vw" widths={[480, 800]} />
        <Photo name="esp-temazcal-1" alt={es ? 'El temazcal de la Finca' : 'The Finca temazcal'} class="ratio-3-4" sizes="(max-width: 900px) 50vw, 25vw" widths={[480, 800]} />
      </div>
    </div>
  </section>

  <section class="section section--arena">
    <div class="wrap grid-2" style="align-items: center">
      <div class="stack">
        <Image src={vatLogo} alt="Viviendo a Tope" class="case-logo" width={240} />
        <p class="label">02 / Viviendo a Tope</p>
        <h2 class="t-heading">{es ? 'Mindfulness en la vida cotidiana' : 'Mindfulness in Everyday Life'}</h2>
        <p>{es ? 'Juan Cruz y Antonio León, de Viviendo a Tope, comparten yoga, meditación y bienestar para todas las personas. Su retiro Mindfulness en la vida cotidiana suma ocho ediciones; la más reciente la hicieron en la Finca, con 45 participantes.' : 'Juan Cruz and Antonio León of Viviendo a Tope share yoga, meditation and wellbeing for everyone. Their retreat Mindfulness in Everyday Life has run eight times; the latest edition took place at the Finca, with 45 participants.'}</p>
        <ul class="rule-list rule-list--soft">
          <li>{es ? 'Retiro de yoga y meditación' : 'Yoga and meditation retreat'}</li>
          <li>{es ? '45 participantes en su edición más reciente' : '45 participants in the latest edition'}</li>
          <li>{es ? 'Ocho ediciones, la más reciente en la Finca' : 'Eight editions, the latest at the Finca'}</li>
        </ul>
        <div class="cluster">
          <a class="fp-btn fp-btn--primary" href="https://viviendoatope.com/" rel="noopener" target="_blank">{es ? 'Visita Viviendo a Tope' : 'Visit Viviendo a Tope'}</a>
        </div>
      </div>
      <div class="stack">
        <div class="pair">
          <Photo name="vat-yoga-terraza" alt={es ? 'Práctica de yoga en la terraza durante el retiro' : 'Yoga practice on the terrace during the retreat'} class="ratio-3-4" sizes="(max-width: 900px) 50vw, 25vw" widths={[480, 800]} />
          <Photo name="vat-meditacion-fogata" alt={es ? 'Meditación nocturna alrededor del fuego' : 'Night meditation around the fire'} class="ratio-3-4" sizes="(max-width: 900px) 50vw, 25vw" widths={[480, 800]} />
        </div>
        <blockquote class="case-quote case-quote--arena-in">
        <p>{es ? '“El espíritu de servicio de todo su personal y las instalaciones son óptimas y muy bien cuidadas. Tienen una organización excelente y el personal es grandioso.”' : '“The whole staff has a true spirit of service, and the facilities are excellent and very well kept. The organization is excellent and the staff is wonderful.”'}</p>
        <footer class="label">Viviendo a Tope</footer>
      </blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2" style="align-items: center">
      <div class="stack">
        <Image src={franciskaLogo} alt="Franciska Decodifica" class="case-logo" width={240} />
        <p class="label">03 / Franciska Decodifica</p>
        <h2 class="t-heading">Mujer Origen</h2>
        <p>{es ? 'Franciska Decodifica es terapeuta en biodescodificación con más de 20 años en el camino del bienestar. Su retiro Mujer Origen acompaña a mujeres en un regreso a sí mismas: magia femenina, sensualidad, sanación de linaje y trauma. Lo ha realizado trece veces; en la Finca reunió a 15 mujeres.' : 'Franciska Decodifica is a biodecoding therapist with more than 20 years on the path of wellbeing. Her retreat Mujer Origen guides women back to themselves: feminine magic, sensuality, lineage healing and trauma. She has run it thirteen times; at the Finca it brought together 15 women.'}</p>
        <ul class="rule-list rule-list--soft">
          <li>{es ? 'Retiro para mujeres' : 'Retreat for women'}</li>
          <li>{es ? '15 participantes en su edición en la Finca' : '15 participants in its edition at the Finca'}</li>
          <li>{es ? 'Trece ediciones, una en la Finca' : 'Thirteen editions, one at the Finca'}</li>
        </ul>
        <div class="cluster">
          <a class="fp-btn fp-btn--primary" href="https://www.franciska-decodifica.com/" rel="noopener" target="_blank">{es ? 'Visita Franciska Decodifica' : 'Visit Franciska Decodifica'}</a>
        </div>
      </div>
      <blockquote class="case-quote case-quote--arena">
        <p>{es ? '“Es un lugar con mucha belleza, paz y armonía, lo cual es muy necesario para retiros de trabajo personal y desarrollo.”' : '“It is a place of great beauty, peace and harmony, which is essential for retreats of personal work and growth.”'}</p>
        <footer class="label">Franciska Decodifica</footer>
      </blockquote>
    </div>
  </section>

  <section class="section deep">
    <div class="wrap measure center stack">
      <p class="label">{es ? 'Tu retiro' : 'Your retreat'}</p>
      <h2 class="t-headline">{es ? '¿Quieres ser el próximo caso de éxito?' : 'Could your retreat be next?'}</h2>
      <p class="muted">{es ? 'Cuéntanos de tu grupo y te enviamos la información para organizar tu retiro en la Finca.' : 'Tell us about your group and we will send you everything you need to host your retreat at the Finca.'}</p>
      <div class="cluster"><Button href={L('/retiros#cotiza')} track="cta_quote">{t('quote', lang)}</Button></div>
    </div>
  </section>
  <Reviews lang={lang} />
</BaseLayout>
<style>
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .case-logo { width: auto; height: auto; max-width: 200px; max-height: 140px; }
  .case-quote--arena { background: var(--arena); }
  .case-quote--arena-in { padding: clamp(20px, 3vw, 32px); }
  .case-quote--arena-in p { font-size: clamp(18px, 1.6vw, 22px); }
  .case-quote { margin: 0; padding: clamp(24px, 4vw, 48px); background: var(--white, #fff); }
  .case-quote p { font-family: var(--font-display); font-size: clamp(22px, 2.2vw, 30px); line-height: 1.35; margin: 0 0 var(--space-4); }
</style>
